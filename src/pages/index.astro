---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Scene Light Manager — Professional Blender Lighting Workspace">
  <!-- Glowing background elements -->
  <div
    class="absolute top-[5%] left-[10%] w-[500px] h-[500px] rounded-full pointer-events-none -z-10 blur-[150px] bg-amber-500/10"
  >
  </div>
  <div
    class="absolute top-[35%] right-[5%] w-[600px] h-[600px] rounded-full pointer-events-none -z-10 blur-[180px] bg-blue-500/5"
  >
  </div>
  <div
    class="absolute bottom-[20%] left-[5%] w-[500px] h-[500px] rounded-full pointer-events-none -z-10 blur-[150px] bg-amber-500/5"
  >
  </div>

  <!-- Hero Section -->
  <section
    class="max-w-[1400px] mx-auto px-6 md:px-12 pt-20 pb-16 text-center relative"
  >
    <!-- Brand Logo -->
    <div class="flex justify-center mb-8 select-none pointer-events-none">
      <img
        src={`${base}promo/promo-logo-slm-c.webp`}
        alt="Scene Light Manager Logo"
        class="h-32 md:h-48 object-contain filter drop-shadow-[0_0_30px_rgba(245,158,11,0.25)] hover:scale-[1.02] transition-transform duration-500"
      />
    </div>

    <!-- Badges -->
    <div class="flex justify-center items-center gap-3 mb-6">
      <span
        class="inline-flex items-center px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 font-mono text-[10px] uppercase tracking-wider"
      >
        Blender 5.1+
      </span>
      <span
        class="inline-flex items-center px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 border border-white/5 font-mono text-[10px] uppercase tracking-wider"
      >
        License: GPL-3.0
      </span>
    </div>

    <!-- Main Title -->
    <h1
      class="text-5xl md:text-7xl font-extralight text-white tracking-tight leading-[1.1] mb-6 max-w-4xl mx-auto"
    >
      Scene Light Manager <br class="hidden md:block" />
      For <span
        class="font-normal text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-amber-500 drop-shadow-[0_2px_20px_rgba(245,158,11,0.2)]"
        >Blender</span
      >
    </h1>

    <h2
      class="text-xl md:text-2xl text-zinc-200 font-light tracking-wide mb-6 max-w-2xl mx-auto"
    >
      Stop fighting Blender’s interface just to light your scene.
    </h2>

    <p
      class="text-sm md:text-base text-zinc-400 font-light leading-relaxed max-w-3xl mx-auto mb-10"
    >
      Scene Light Manager (SLM) is a professional, high-fidelity lighting
      workflow toolkit designed to keep you in the creative flow. Adjust
      intensity, change shapes, solo lights, control HDRI rotation, and manage
      light/shadow linking <strong>directly in the 3D Viewport</strong> without ever
      opening the properties sidebar.
    </p>

    <div class="flex justify-center items-center mb-12">
      <a
        href={`${base}light-manager`}
        class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 rounded-full bg-white text-zinc-950 font-mono text-xs uppercase tracking-widest font-semibold hover:bg-zinc-200 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-[0_4px_25px_rgba(255,255,255,0.15)]"
      >
        Explore Documentation
      </a>
    </div>

    <!-- Marketplaces & Platforms Row -->
    <div class="flex flex-col items-center gap-5 mb-24">
      <span
        class="text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-500"
        >Available On</span
      >
      <div class="flex flex-wrap justify-center items-center gap-5">
        <a
          href="https://superhivemarket.com/products/k-tools-scene-light-manager-slm/"
          target="_blank"
          class="inline-flex items-center gap-4 px-10 py-5 rounded-full bg-white text-zinc-950 font-mono text-xs uppercase tracking-widest font-semibold hover:bg-zinc-200 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-[0_4px_25px_rgba(255,255,255,0.15)]"
          title="Superhive"
        >
          <img
            src={`${base}third_party/superhive.png`}
            alt="Superhive"
            class="h-10 object-contain"
          />
          <span>Superhive</span>
        </a>
        <a
          href="https://kezives.gumroad.com/l/slm"
          target="_blank"
          class="inline-flex items-center gap-4 px-10 py-5 rounded-full bg-white text-zinc-950 font-mono text-xs uppercase tracking-widest font-semibold hover:bg-zinc-200 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-[0_4px_25px_rgba(255,255,255,0.15)]"
          title="Gumroad"
        >
          <img
            src={`${base}third_party/gumroad.png`}
            alt="Gumroad"
            class="h-10 object-contain"
          />
          <span>Gumroad</span>
        </a>
      </div>
    </div>

    <!-- Video Demonstration Placeholder
    <div
      class="relative w-full max-w-[1200px] mx-auto aspect-[21/9] bg-zinc-950/20 border border-white/5 rounded-3xl flex items-center justify-center mb-28 group overflow-hidden"
    >
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: radial-gradient(circle, #3f3f46 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>

      <div class="relative z-10 flex flex-col items-center gap-3">
        <div
          class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400 group-hover:scale-105 group-hover:border-amber-500/30 group-hover:text-amber-400 transition-all duration-500 shadow-inner"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <span
          class="text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-500 group-hover:text-zinc-400 transition-colors duration-500"
        >
          Video Demonstration Placeholder
        </span>
      </div>
    </div>
    -->
  </section>

  <!-- Section: Why Scene Light Manager? (The SLM Difference) -->
  <section
    class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 mb-28 border-t border-white/5"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <span
          class="text-[10px] font-mono tracking-[0.3em] uppercase text-amber-400 mb-2 block"
        >
          The SLM Difference
        </span>
        <h2
          class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-6"
        >
          Why Scene Light Manager?
        </h2>
        <p class="text-sm text-zinc-400 font-light leading-relaxed mb-6">
          In vanilla Blender, setting up cinematic lighting is a tedious loop:
          select a light, look at the properties panel, drag a slider, look back
          at the viewport, select another light, expand sub-panels, repeat.
        </p>
        <div class="p-4 rounded-xl bg-amber-500/5 border border-amber-500/10">
          <p class="text-xs text-amber-300 font-mono">
            <strong
              >SLM changes everything by bringing the controls to your cursor.</strong
            >
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Diff Card 1 -->
        <div
          class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300"
        >
          <div
            class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2"
          >
            Zero Context Switching
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            Adjust power, size, beam angle, and color directly on the light
            object inside the 3D Viewport.
          </p>
        </div>

        <!-- Diff Card 2 -->
        <div
          class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300"
        >
          <div
            class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2"
          >
            Instant Visual Feedback
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            High-fidelity GPU outlines highlight exactly which objects are
            affected by light or shadow linking in real time.
          </p>
        </div>

        <!-- Diff Card 3 -->
        <div
          class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300"
        >
          <div
            class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2"
          >
            Intuitive Environment Controls
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            Rotate your HDRI or position the Nishita sun texture with simple
            viewport gestures.
          </p>
        </div>

        <!-- Diff Card 4 -->
        <div
          class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300"
        >
          <div
            class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2"
          >
            Pure Performance
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            Built from the ground up for heavy production scenes with zero
            overhead.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Key Features -->
  <section
    class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 mb-28 border-t border-white/5"
  >
    <div class="text-center max-w-2xl mx-auto mb-20">
      <span
        class="text-[10px] font-mono tracking-[0.3em] uppercase text-amber-400 mb-2 block"
      >
        Feature Suite
      </span>
      <h2
        class="text-3xl md:text-5xl font-light text-white tracking-tight leading-none mb-4"
      >
        Key Features
      </h2>
      <p class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed">
        Engineered for technical lighting pipelines, providing professional UI
        tools and precise feedback controls.
      </p>
    </div>

    <!-- Feature alternating rows -->
    <div class="space-y-32">
      <!-- Feature 1 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div
            class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs"
          >
            01
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            Viewport Gizmo Interface & Floating Overlay
          </h3>
          <p
            class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed"
          >
            Gain instant, contextual access to light settings directly on the
            active light:
          </p>
          <ul
            class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20"
          >
            <li>
              <strong class="text-zinc-200">Smart Buttons:</strong> Click interactive
              icons next to your selected light to cycle types, change area shapes,
              toggle solo mode, adjust spot beam spreads, or tweak sizes.
            </li>
            <li>
              <strong class="text-zinc-200">Real-Time Value Overlay:</strong> Get
              beautiful, color-coded HUD feedback showing your precise parameter values
              as you drag. Choose to lock the HUD to your mouse or snap it cleanly
              below the gizmo cluster.
            </li>
            <li>
              <strong class="text-zinc-200">Alt-Modifier Batch Control:</strong> Hold
              <code
                class="bg-zinc-900 px-1 py-0.5 rounded border border-white/5 text-amber-400"
                >Alt</code
              > while adjusting a viewport gizmo to propagate the change to all selected
              lights instantly.
            </li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <div
            class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl"
          >
            <img
              src={`${base}overlay_gizmos/viewport_2d_gizmos.png`}
              alt="Viewport Gizmos Adjustment Interface"
              class="w-full rounded-xl zoomable-img cursor-zoom-in hover:scale-[1.01] transition-transform duration-500"
            />
            <div
              class="absolute bottom-4 right-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none"
            >
              Click to zoom
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div
            class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl"
          >
            <img
              src={`${base}promo/promo-linking.webp`}
              alt="Light and Shadow Linking Visual Highlights"
              class="w-full rounded-xl zoomable-img cursor-zoom-in hover:scale-[1.01] transition-transform duration-500"
            />
            <div
              class="absolute bottom-4 right-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none"
            >
              Click to zoom
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
          <div
            class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs"
          >
            02
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            High-Fidelity GPU Linking Highlights
          </h3>
          <p
            class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed"
          >
            Configure Blender’s powerful Light and Shadow Linking systems
            visually:
          </p>
          <ul
            class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20"
          >
            <li>
              <strong class="text-zinc-200">Visual Silhouette Outlines:</strong> Selecting
              any light instantly projects clean, anti-aliased wireframes and silhouette
              highlights over the linked receiver or blocker geometry.
            </li>
            <li>
              <strong class="text-zinc-200">Dynamic Customization:</strong> Choose
              from three outline modes (<em>Silhouette</em>, <em>Wireframe</em>,
              or <em>Both</em>), and customize line thickness and colors to
              match your scene style.
            </li>
          </ul>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div
            class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs"
          >
            03
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            Interactive HDRI & Sky Rotation
          </h3>
          <p
            class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed"
          >
            Ditch the shader editor mapping node. Rotate your environment from
            any camera angle:
          </p>
          <ul
            class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20"
          >
            <li>
              <strong class="text-zinc-200">Auto-Detection Engine:</strong> Automatically
              detects and rotates the active background environment—whether it is
              Nishita Sky, a World Mapping node (Z Rotation), or Blender's built-in
              Viewport HDRI.
            </li>
            <li>
              <strong class="text-zinc-200">Instant Drag Gesture:</strong> Hold <code
                class="bg-zinc-900 px-1 py-0.5 rounded border border-white/5 text-amber-400"
                >Ctrl + Alt + RMB</code
              > and drag horizontally to spin the dome. Release to commit, or cancel
              with a right click.
            </li>
            <li>
              <strong class="text-zinc-200">HUD Angle Readout:</strong> A clean digital
              compass at the bottom of the viewport displays the exact rotation angle
              in real time.
            </li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <div
            class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl"
          >
            <!-- Multi-image container with fade transition -->
            <div
              class="relative w-full aspect-[16/10] overflow-hidden rounded-xl bg-zinc-950"
            >
              <img
                id="world-image-a"
                src={`${base}promo/promo-world_a.webp`}
                alt="Interactive HDRI World Rotation — Studio Setup"
                class="absolute inset-0 w-full h-full object-cover zoomable-img cursor-zoom-in transition-opacity duration-500 opacity-100"
              />
              <img
                id="world-image-b"
                src={`${base}promo/promo-world_b.webp`}
                alt="Interactive HDRI World Rotation — Exterior Scene"
                class="absolute inset-0 w-full h-full object-cover zoomable-img cursor-zoom-in transition-opacity duration-500 opacity-0 pointer-events-none"
              />
            </div>

            <!-- Controls overlay -->
            <div
              class="absolute top-4 right-4 flex gap-1.5 bg-zinc-950/85 border border-white/10 rounded-full p-1 backdrop-blur-sm shadow-xl"
            >
              <button
                id="btn-world-a"
                class="px-3 py-1 text-[9px] font-mono text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-full transition-all cursor-pointer font-medium uppercase tracking-wider"
              >
                Studio Setup
              </button>
              <button
                id="btn-world-b"
                class="px-3 py-1 text-[9px] font-mono text-zinc-400 border border-transparent rounded-full hover:bg-white/5 hover:text-white transition-all cursor-pointer font-medium uppercase tracking-wider"
              >
                Exterior Scene
              </button>
            </div>

            <div
              class="absolute bottom-4 left-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none"
            >
              Click image to zoom
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 4: HDR Studio Light Textures -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div
            class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl"
          >
            <!-- Multi-image container with fade transition -->
            <div
              class="relative w-full aspect-[16/10] overflow-hidden rounded-xl bg-zinc-950"
            >
              <img
                id="texture-image-a"
                src={`${base}promo/promo-light_texture_a.webp`}
                alt="HDR Studio Light Textures — Gobo Projector Setup"
                class="absolute inset-0 w-full h-full object-cover zoomable-img cursor-zoom-in transition-opacity duration-500 opacity-100"
              />
              <img
                id="texture-image-b"
                src={`${base}promo/promo-light_texture_b.webp`}
                alt="HDR Studio Light Textures — Studio Softbox"
                class="absolute inset-0 w-full h-full object-cover zoomable-img cursor-zoom-in transition-opacity duration-500 opacity-0 pointer-events-none"
              />
            </div>

            <!-- Controls overlay -->
            <div
              class="absolute top-4 right-4 flex gap-1.5 bg-zinc-950/85 border border-white/10 rounded-full p-1 backdrop-blur-sm shadow-xl"
            >
              <button
                id="btn-texture-a"
                class="px-3 py-1 text-[9px] font-mono text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-full transition-all cursor-pointer font-medium uppercase tracking-wider"
              >
                Gobo Projector
              </button>
              <button
                id="btn-texture-b"
                class="px-3 py-1 text-[9px] font-mono text-zinc-400 border border-transparent rounded-full hover:bg-white/5 hover:text-white transition-all cursor-pointer font-medium uppercase tracking-wider"
              >
                Studio Softbox
              </button>
            </div>

            <div
              class="absolute bottom-4 left-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none"
            >
              Click image to zoom
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
          <div
            class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs"
          >
            04
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            HDR Studio Light Textures & Gobos
          </h3>
          <p
            class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed"
          >
            Project real-world high-dynamic-range softboxes and patterns
            directly from Blender Area Lights:
          </p>
          <ul
            class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20"
          >
            <li>
              <strong class="text-zinc-200">Photographic Realism:</strong> Map photographic
              softbox reflection textures and studio Gobos with a single click.
            </li>
            <li>
              <strong class="text-zinc-200">Integrated Node Automation:</strong> Behind
              the scenes, SLM handles shader setups, texture mapping coordinate projections,
              and strength balance.
            </li>
            <li>
              <strong class="text-zinc-200">Interactive Tweaks:</strong> Adjust Gobo
              rotation, scale, and softness directly from viewport operators.
            </li>
          </ul>
        </div>
      </div>

      <!-- Feature 5: Cinematic Presets & Lighting Rigs -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div
            class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs"
          >
            05
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            Cinematic Presets & Custom Lighting Rigs
          </h3>
          <p
            class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed"
          >
            Build master lighting setups in seconds using built-in rigs and
            saving custom presets:
          </p>
          <ul
            class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20"
          >
            <li>
              <strong class="text-zinc-200">Instant Rig Spawning:</strong> Spawn standard
              3-point rigs, butterfly setups, or backlighting rings aligned to your
              active viewport camera.
            </li>
            <li>
              <strong class="text-zinc-200">Preset Library Manager:</strong> Save
              complete scene lighting states to the global asset library and restore
              them instantly.
            </li>
            <li>
              <strong class="text-zinc-200">Non-Destructive Mixing:</strong> Test
              different lighting directions, colors, and intensities by saving snapshots
              as presets.
            </li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <div
            class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl"
          >
            <!-- Multi-image container with fade transition -->
            <div
              class="relative w-full aspect-[16/10] overflow-hidden rounded-xl bg-zinc-950"
            >
              <img
                id="presets-image-a"
                src={`${base}promo/promo-presets_a.webp`}
                alt="Cinematic Presets & Lighting Rigs — Portrait Studio Setup"
                class="absolute inset-0 w-full h-full object-cover zoomable-img cursor-zoom-in transition-opacity duration-500 opacity-100"
              />
              <img
                id="presets-image-b"
                src={`${base}promo/promo-presets_b.webp`}
