---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Scene Light Manager — Premium Blender Lighting Workspace">
  <!-- Glowing background elements -->
  <div
    class="absolute top-[10%] left-[10%] w-[500px] h-[500px] rounded-full pointer-events-none -z-10 blur-[150px] bg-amber-500/10"
  >
  </div>
  <div
    class="absolute top-[40%] right-[5%] w-[600px] h-[600px] rounded-full pointer-events-none -z-10 blur-[180px] bg-blue-500/5"
  >
  </div>

  <!-- Hero Section -->
  <section
    class="max-w-[1400px] mx-auto px-6 md:px-12 pt-20 pb-16 text-center relative"
  >
    <h1
      class="text-5xl md:text-7xl font-extralight text-white tracking-tight leading-[1.1] mb-6 max-w-4xl mx-auto"
    >
      Sculpt Your Scenes <br class="hidden md:block" />
      With <span
        class="font-normal text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-amber-500 drop-shadow-[0_2px_20px_rgba(245,158,11,0.2)]"
        >Interactive Light</span
      >
    </h1>

    <p
      class="text-sm md:text-lg text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto mb-10"
    >
      The ultimate parametric lighting suite for Blender. Accelerate your
      production workflow with collection-level overrides, viewport spatial
      gizmos, and real-time GPU-accelerated previews.
    </p>

    <div class="flex justify-center items-center mb-12">
      <a
        href={`${base}light-manager`}
        class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 rounded-full bg-white text-zinc-950 font-mono text-xs uppercase tracking-widest font-semibold hover:bg-zinc-200 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-[0_4px_25px_rgba(255,255,255,0.15)]"
      >
        Explore Documentation
      </a>
    </div>

    <!-- Marketplaces & Platforms Row -->
    <div class="flex flex-col items-center gap-5 mb-24">
      <span
        class="text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-500"
        >Available On</span
      >
      <div class="flex flex-wrap justify-center items-center gap-5">
        <a
          href="https://kezives.gumroad.com/l/slm"
          target="_blank"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] text-zinc-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.97] hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] backdrop-blur-sm"
          title="Gumroad"
        >
          <img
            src={`${base}third_party/gumroad.png`}
            alt="Gumroad"
            class="h-5 object-contain"
          />
          <span>Gumroad</span>
        </a>
        <a
          href="https://superhivemarket.com/"
          target="_blank"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] text-zinc-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.97] hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] backdrop-blur-sm"
          title="Superhive"
        >
          <img
            src={`${base}third_party/superhive.png`}
            alt="Superhive"
            class="h-5 object-contain"
          />
          <span>Superhive</span>
        </a>
        <a
          href="https://www.blenderkit.com"
          target="_blank"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] text-zinc-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.97] hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] backdrop-blur-sm"
          title="BlenderKit"
        >
          <img
            src={`${base}third_party/blenderkit.png`}
            alt="BlenderKit"
            class="h-5 object-contain"
          />
          <span>BlenderKit</span>
        </a>
      </div>
    </div>

    <!-- Interactive 3D Viewport Simulator (Banner) -->
    <div
      class="relative w-full max-w-[1200px] mx-auto bg-zinc-950/40 border border-white/5 rounded-3xl overflow-hidden backdrop-blur-md shadow-[0_20px_50px_rgba(0,0,0,0.5)] mb-28 group"
    >
      <!-- Top header bar -->
      <div
        class="flex items-center justify-between px-6 py-3 border-b border-white/5 bg-zinc-900/40 font-mono text-[10px] text-zinc-500"
      >
        <div class="flex items-center gap-3">
          <span
            class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/30"
          ></span>
          <span
            class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/30"
          ></span>
          <span
            class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/30"
          ></span>
          <span class="ml-2 text-zinc-400"
            >Blender 3D Viewport — SLM_Rig_Active</span
          >
        </div>
        <div class="flex items-center gap-4">
          <span>Global</span>
          <div
            class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            SOLO ACTIVE
          </div>
        </div>
      </div>

      <!-- Main viewport arena -->
      <div
        class="relative w-full aspect-[21/9] bg-gradient-to-b from-zinc-950 to-zinc-900/60 flex items-center justify-center overflow-hidden"
      >
        <!-- Grid overlay pattern -->
        <div
          class="absolute inset-0 opacity-15"
          style="background-image: radial-gradient(circle, #3f3f46 1px, transparent 1px); background-size: 24px 24px;"
        >
        </div>

        <!-- Technical center guidelines -->
        <div
          class="absolute inset-0 flex items-center justify-center pointer-events-none"
        >
          <div
            class="w-full h-[1px] bg-gradient-to-r from-transparent via-zinc-800 to-transparent"
          >
          </div>
          <div
            class="h-full w-[1px] bg-gradient-to-b from-transparent via-zinc-800 to-transparent"
          >
          </div>
        </div>

        <!-- Simulated 3D Elements -->
        <div
          class="relative w-[300px] h-[200px] flex items-center justify-center"
        >
          <!-- Central target mesh (abstract sphere) -->
          <div
            class="absolute w-16 h-16 rounded-full border border-white/10 flex items-center justify-center animate-spin"
            style="animation-duration: 20s"
          >
            <div
              class="w-12 h-12 rounded-full border border-dashed border-zinc-600"
            >
            </div>
            <!-- Axis lines -->
            <div class="absolute w-20 h-[1px] bg-zinc-700"></div>
            <div class="absolute h-20 w-[1px] bg-zinc-700"></div>
          </div>
          <div
            class="absolute w-4 h-4 rounded-full bg-amber-400/20 border border-amber-400 flex items-center justify-center shadow-[0_0_10px_rgba(245,158,11,0.5)]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          </div>

          <!-- Lights and lines -->
          <!-- Key Light -->
          <div
            class="absolute -top-12 -left-16 flex flex-col items-center group/light"
          >
            <div
              class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center relative hover:scale-110 hover:border-amber-400 transition-all duration-300 shadow-[0_0_20px_rgba(245,158,11,0.2)]"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-amber-400"
                ><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path><path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path></svg
              >
              <!-- Target constraint path line -->
              <div
                class="absolute w-[180px] h-[2px] border-t border-dashed border-amber-500/30 origin-bottom-left rotate-[40deg] -bottom-[1px] left-5 pointer-events-none"
              >
              </div>
            </div>
            <span
              class="text-[8px] font-mono text-amber-400 mt-1 uppercase tracking-wider bg-zinc-950/80 px-1 py-0.5 rounded border border-white/5"
              >Key Light</span
            >
          </div>

          <!-- Fill Light -->
          <div
            class="absolute top-20 -right-24 flex flex-col items-center group/light"
          >
            <div
              class="w-8 h-8 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center relative hover:scale-110 hover:border-blue-400 transition-all duration-300 shadow-[0_0_15px_rgba(59,130,246,0.15)]"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-blue-400"
                ><circle cx="12" cy="12" r="4"></circle><path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path></svg
              >
              <!-- Target constraint path line -->
              <div
                class="absolute w-[120px] h-[2px] border-t border-dashed border-blue-500/20 origin-top-right rotate-[145deg] top-4 right-4 pointer-events-none"
              >
              </div>
            </div>
            <span
              class="text-[8px] font-mono text-blue-400 mt-1 uppercase tracking-wider bg-zinc-950/80 px-1 py-0.5 rounded border border-white/5"
              >Fill Light</span
            >
          </div>

          <!-- Rim Light -->
          <div
            class="absolute -top-16 right-16 flex flex-col items-center group/light"
          >
            <div
              class="w-8 h-8 rounded-full bg-white/5 border border-white/20 flex items-center justify-center relative hover:scale-110 hover:border-white transition-all duration-300"
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-white"
                ><circle cx="12" cy="12" r="4"></circle><path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path></svg
              >
              <!-- Target constraint path line -->
              <div
                class="absolute w-[110px] h-[2px] border-t border-dashed border-white/20 origin-bottom-right rotate-[-55deg] -bottom-[1px] right-4 pointer-events-none"
              >
              </div>
            </div>
            <span
              class="text-[8px] font-mono text-zinc-400 mt-1 uppercase tracking-wider bg-zinc-950/80 px-1 py-0.5 rounded border border-white/5"
              >Rim Light</span
            >
          </div>
        </div>

        <!-- Floating UI panel simulating the addon -->
        <div
          class="absolute bottom-6 right-6 w-64 bg-zinc-950/80 border border-white/10 rounded-xl p-4 font-mono text-[9px] text-zinc-400 shadow-2xl backdrop-blur-md"
        >
          <div
            class="flex items-center justify-between border-b border-white/5 pb-2 mb-3"
          >
            <span class="text-white font-semibold">▼ SCENE LIGHT MANAGER</span>
            <span class="text-amber-400">[RIG_3POINT]</span>
          </div>
          <div class="space-y-3">
            <div>
              <div class="flex justify-between mb-1">
                <span>Base Energy</span>
                <span class="text-white">120 W</span>
              </div>
              <div
                class="w-full h-1.5 bg-zinc-900 rounded border border-white/5 overflow-hidden"
              >
                <div
                  class="w-3/5 h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded"
                >
                </div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span>Contrast Ratio</span>
                <span class="text-white">4.2 : 1</span>
              </div>
              <div
                class="w-full h-1.5 bg-zinc-900 rounded border border-white/5 overflow-hidden"
              >
                <div
                  class="w-[75%] h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded"
                >
                </div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span>Rig Radius</span>
                <span class="text-white">5.80m</span>
              </div>
              <div
                class="w-full h-1.5 bg-zinc-900 rounded border border-white/5 overflow-hidden"
              >
                <div
                  class="w-2/5 h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded"
                >
                </div>
              </div>
            </div>
            <div class="flex gap-2 pt-1">
              <div
                class="flex-1 py-1 px-2 bg-zinc-900 hover:bg-zinc-800 rounded border border-white/5 text-center text-white cursor-pointer select-none"
              >
                Link Light
              </div>
              <div
                class="flex-1 py-1 px-2 bg-zinc-900 hover:bg-zinc-800 rounded border border-white/5 text-center text-white cursor-pointer select-none"
              >
                Spawn Rig
              </div>
            </div>
          </div>
        </div>

        <!-- Floating UI panel for Collection Overrides (Left Side) -->
        <div
          class="absolute bottom-6 left-6 w-52 bg-zinc-950/80 border border-white/10 rounded-xl p-4 font-mono text-[9px] text-zinc-400 shadow-2xl backdrop-blur-md"
        >
          <div
            class="flex items-center justify-between border-b border-white/5 pb-2 mb-2"
          >
            <span class="text-white font-semibold">▼ COLLECTION OVERRIDES</span>
          </div>
          <div class="space-y-1.5">
            <div
              class="flex items-center justify-between py-1 px-1.5 rounded bg-white/[0.02] border border-white/5"
            >
              <span class="text-white">✔ Character_Light</span>
              <span class="text-zinc-500">Ex: +1.5</span>
            </div>
            <div
              class="flex items-center justify-between py-1 px-1.5 rounded bg-white/[0.02] border border-white/5"
            >
              <span class="text-white">✔ BG_Light_Group</span>
              <span class="text-zinc-500">Ex: -0.8</span>
            </div>
            <div
              class="flex items-center justify-between py-1 px-1.5 rounded bg-white/[0.02] border border-white/5"
            >
              <span class="text-white">✔ Rim_Accent</span>
              <span class="text-amber-400 font-semibold">SOLO</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Showcase Section -->
  <section class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 mb-28 text-center">
    <div class="max-w-2xl mx-auto mb-12">
      <span
        class="text-[10px] font-mono tracking-[0.3em] uppercase text-amber-400 mb-2 block"
        >Watch SLM in Action</span
      >
      <h2
        class="text-3xl md:text-4xl font-light text-white tracking-tight leading-none mb-4"
      >
        Dynamic Viewport Workflows
      </h2>
      <p class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed">
        See how interactive gizmos, local presets, and responsive overrides
        completely transform the process of setting up studio-ready renders.
      </p>
    </div>

    <!-- Video Player Mockup -->
    <div
      class="relative aspect-video w-full max-w-[900px] mx-auto bg-zinc-900 border border-white/5 rounded-3xl overflow-hidden shadow-2xl group cursor-pointer"
    >
      <!-- Simulated Video Background (Abstract dark tech grid + lens flares) -->
      <div
        class="absolute inset-0 bg-gradient-to-tr from-zinc-950 via-zinc-900 to-zinc-950 flex items-center justify-center"
      >
        <!-- Glowing Amber/Orange Core -->
        <div
          class="absolute w-80 h-80 rounded-full bg-amber-500/10 blur-[80px] pointer-events-none group-hover:scale-110 transition-transform duration-700"
        >
        </div>
        <div
          class="absolute w-96 h-96 rounded-full bg-blue-500/5 blur-[100px] pointer-events-none"
        >
        </div>

        <!-- Grid layout overlay in mock video -->
        <svg
          class="absolute inset-0 w-full h-full opacity-20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <pattern
              id="grid"
              width="40"
              height="40"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M 40 0 L 0 0 0 40"
                fill="none"
                stroke="#27272a"
                stroke-width="1"></path>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)"></rect>
        </svg>

        <!-- Simulated render lines -->
        <div
          class="absolute border border-dashed border-amber-500/30 px-6 py-4 rounded-xl flex flex-col items-center"
        >
          <span
            class="text-[9px] font-mono text-amber-500 tracking-widest uppercase mb-1"
            >Interactive Video Preview</span
          >
          <span class="text-zinc-500 font-mono text-[8px]">0:00 / 3:15</span>
        </div>
      </div>

      <!-- Play button overlay -->
      <div class="absolute inset-0 flex items-center justify-center z-10">
        <div
          class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-zinc-950/80 border border-white/10 flex items-center justify-center relative hover:scale-110 hover:border-amber-400/40 transition-all duration-300 group shadow-2xl backdrop-blur-sm"
        >
          <!-- Pulse rings -->
          <div
            class="absolute inset-0 rounded-full border border-amber-500/30 animate-ping group-hover:duration-1000"
          >
          </div>

          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-white ml-1.5 transition-colors duration-300 group-hover:text-amber-400"
            ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
          >
        </div>
      </div>

      <!-- Bottom controls bar mockup -->
      <div
        class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 font-mono text-[9px] text-zinc-400"
      >
        <div class="flex items-center gap-4 w-full">
          <!-- Play icon -->
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-white"
            ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
          >

          <!-- Progress bar -->
          <div
            class="flex-grow h-1 bg-white/20 rounded-full relative overflow-hidden"
          >
            <div
              class="w-[15%] h-full bg-gradient-to-r from-amber-500 to-orange-500"
            >
            </div>
          </div>

          <!-- Time text -->
          <span>00:45 / 03:12</span>

          <!-- Volume icon -->
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-zinc-400"
            ><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path
              d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
            ></path></svg
          >

          <!-- Fullscreen icon -->
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-zinc-400"
            ><path
              d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
            ></path></svg
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Core Features Section -->
  <section class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 mb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div
        class="bg-white/[0.01] border border-white/5 hover:border-amber-500/20 hover:bg-white/[0.02] p-8 rounded-2xl transition-all duration-300 group"
      >
        <div
          class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-amber-400"
            ><path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path></svg
          >
        </div>
        <h3 class="text-lg font-normal text-white mb-3">
          Parametric Studio Rigs
        </h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-light">
          Spawn pre-calibrated portrait, product, and architectural lighting
          configurations instantly. Adjust distances, contrast ratios, and
          temperatures in real-time.
        </p>
      </div>

      <!-- Feature 2 -->
      <div
        class="bg-white/[0.01] border border-white/5 hover:border-amber-500/20 hover:bg-white/[0.02] p-8 rounded-2xl transition-all duration-300 group"
      >
        <div
          class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-amber-400"
            ><circle cx="12" cy="12" r="10"></circle><polygon
              points="10 8 16 12 10 16 10 8"></polygon></svg
          >
        </div>
        <h3 class="text-lg font-normal text-white mb-3">
          Spatial Gizmo Interface
        </h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-light">
          Adjust lighting values right inside the 3D viewport. Skip the
          properties panel by tweaking beam spreads, area dimensions, and
          visibility toggles directly on objects.
        </p>
      </div>

      <!-- Feature 3 -->
      <div
        class="bg-white/[0.01] border border-white/5 hover:border-amber-500/20 hover:bg-white/[0.02] p-8 rounded-2xl transition-all duration-300 group"
      >
        <div
          class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-amber-400"
            ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
              x1="9"
