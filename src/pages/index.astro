---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Scene Light Manager — Professional Blender Lighting Workspace">
  <!-- Glowing background elements -->
  <div
    class="absolute top-[5%] left-[10%] w-[500px] h-[500px] rounded-full pointer-events-none -z-10 blur-[150px] bg-amber-500/10"
  >
  </div>
  <div
    class="absolute top-[35%] right-[5%] w-[600px] h-[600px] rounded-full pointer-events-none -z-10 blur-[180px] bg-blue-500/5"
  >
  </div>
  <div
    class="absolute bottom-[20%] left-[5%] w-[500px] h-[500px] rounded-full pointer-events-none -z-10 blur-[150px] bg-amber-500/5"
  >
  </div>

  <!-- Hero Section -->
  <section
    class="max-w-[1400px] mx-auto px-6 md:px-12 pt-20 pb-16 text-center relative"
  >
    <!-- Badges -->
    <div class="flex justify-center items-center gap-3 mb-6">
      <span class="inline-flex items-center px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 font-mono text-[10px] uppercase tracking-wider">
        Blender 5.1+
      </span>
      <span class="inline-flex items-center px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 border border-white/5 font-mono text-[10px] uppercase tracking-wider">
        License: GPL-3.0
      </span>
    </div>

    <!-- Main Title -->
    <h1
      class="text-5xl md:text-7xl font-extralight text-white tracking-tight leading-[1.1] mb-6 max-w-4xl mx-auto"
    >
      💡 Scene Light Manager <br class="hidden md:block" />
      For <span
        class="font-normal text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-amber-500 drop-shadow-[0_2px_20px_rgba(245,158,11,0.2)]"
        >Blender</span
      >
    </h1>

    <h2 class="text-xl md:text-2xl text-zinc-200 font-light tracking-wide mb-6 max-w-2xl mx-auto">
      Stop fighting Blender’s interface just to light your scene.
    </h2>

    <p
      class="text-sm md:text-base text-zinc-400 font-light leading-relaxed max-w-3xl mx-auto mb-10"
    >
      Scene Light Manager (SLM) is a professional, high-fidelity lighting workflow toolkit designed to keep you in the creative flow. Adjust intensity, change shapes, solo lights, control HDRI rotation, and manage light/shadow linking <strong>directly in the 3D Viewport</strong> without ever opening the properties sidebar.
    </p>

    <div class="flex justify-center items-center mb-12">
      <a
        href={`${base}light-manager`}
        class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 rounded-full bg-white text-zinc-950 font-mono text-xs uppercase tracking-widest font-semibold hover:bg-zinc-200 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-[0_4px_25px_rgba(255,255,255,0.15)]"
      >
        Explore Documentation
      </a>
    </div>

    <!-- Marketplaces & Platforms Row -->
    <div class="flex flex-col items-center gap-5 mb-24">
      <span
        class="text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-500"
        >Available On</span
      >
      <div class="flex flex-wrap justify-center items-center gap-5">
        <a
          href="https://kezives.gumroad.com/l/slm"
          target="_blank"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] text-zinc-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.97] hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] backdrop-blur-sm"
          title="Gumroad"
        >
          <img
            src={`${base}third_party/gumroad.png`}
            alt="Gumroad"
            class="h-5 object-contain"
          />
          <span>Gumroad</span>
        </a>
        <a
          href="https://superhivemarket.com/"
          target="_blank"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] text-zinc-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.97] hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] backdrop-blur-sm"
          title="Superhive"
        >
          <img
            src={`${base}third_party/superhive.png`}
            alt="Superhive"
            class="h-5 object-contain"
          />
          <span>Superhive</span>
        </a>
        <a
          href="https://www.blenderkit.com"
          target="_blank"
          class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.08] text-zinc-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.97] hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] backdrop-blur-sm"
          title="BlenderKit"
        >
          <img
            src={`${base}third_party/blenderkit.png`}
            alt="BlenderKit"
            class="h-5 object-contain"
          />
          <span>BlenderKit</span>
        </a>
      </div>
    </div>

    <!-- Interactive 3D Viewport Simulator (Banner / Teaser) -->
    <div
      class="relative w-full max-w-[1200px] mx-auto bg-zinc-950/40 border border-white/5 rounded-3xl overflow-hidden backdrop-blur-md shadow-[0_20px_50px_rgba(0,0,0,0.5)] mb-28 group"
    >
      <!-- Top header bar -->
      <div
        class="flex items-center justify-between px-6 py-3 border-b border-white/5 bg-zinc-900/40 font-mono text-[10px] text-zinc-500"
      >
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/30"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/30"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/30"></span>
          <span class="ml-2 text-zinc-400">Blender 3D Viewport — SLM_Viewport_Active</span>
        </div>
        <div class="flex items-center gap-4">
          <span>Global</span>
          <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            SOLO ACTIVE
          </div>
        </div>
      </div>

      <!-- Main viewport arena -->
      <div class="relative w-full aspect-[21/9] bg-gradient-to-b from-zinc-950 to-zinc-900/60 flex items-center justify-center overflow-hidden">
        <!-- Grid overlay pattern -->
        <div class="absolute inset-0 opacity-15" style="background-image: radial-gradient(circle, #3f3f46 1px, transparent 1px); background-size: 24px 24px;"></div>

        <!-- Technical center guidelines -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-zinc-800 to-transparent"></div>
          <div class="h-full w-[1px] bg-gradient-to-b from-transparent via-zinc-800 to-transparent"></div>
        </div>

        <!-- Simulated 3D Elements -->
        <div class="relative w-[300px] h-[200px] flex items-center justify-center">
          <div class="absolute w-16 h-16 rounded-full border border-white/10 flex items-center justify-center animate-spin" style="animation-duration: 20s">
            <div class="w-12 h-12 rounded-full border border-dashed border-zinc-600"></div>
            <div class="absolute w-20 h-[1px] bg-zinc-700"></div>
            <div class="absolute h-20 w-[1px] bg-zinc-700"></div>
          </div>
          <div class="absolute w-4 h-4 rounded-full bg-amber-400/20 border border-amber-400 flex items-center justify-center shadow-[0_0_10px_rgba(245,158,11,0.5)]">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          </div>

          <!-- Key Light -->
          <div class="absolute -top-12 -left-16 flex flex-col items-center group/light">
            <div class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center relative hover:scale-110 hover:border-amber-400 transition-all duration-300 shadow-[0_0_20px_rgba(245,158,11,0.2)]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-400">
                <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <div class="absolute w-[180px] h-[2px] border-t border-dashed border-amber-500/30 origin-bottom-left rotate-[40deg] -bottom-[1px] left-5 pointer-events-none"></div>
            </div>
            <span class="text-[8px] font-mono text-amber-400 mt-1 uppercase tracking-wider bg-zinc-950/80 px-1 py-0.5 rounded border border-white/5">Key Light</span>
          </div>

          <!-- Fill Light -->
          <div class="absolute top-20 -right-24 flex flex-col items-center group/light">
            <div class="w-8 h-8 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center relative hover:scale-110 hover:border-blue-400 transition-all duration-300 shadow-[0_0_15px_rgba(59,130,246,0.15)]">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue-400">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <div class="absolute w-[120px] h-[2px] border-t border-dashed border-blue-500/20 origin-top-right rotate-[145deg] top-4 right-4 pointer-events-none"></div>
            </div>
            <span class="text-[8px] font-mono text-blue-400 mt-1 uppercase tracking-wider bg-zinc-950/80 px-1 py-0.5 rounded border border-white/5">Fill Light</span>
          </div>

          <!-- Rim Light -->
          <div class="absolute -top-16 right-16 flex flex-col items-center group/light">
            <div class="w-8 h-8 rounded-full bg-white/5 border border-white/20 flex items-center justify-center relative hover:scale-110 hover:border-white transition-all duration-300">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <div class="absolute w-[110px] h-[2px] border-t border-dashed border-white/20 origin-bottom-right rotate-[-55deg] -bottom-[1px] right-4 pointer-events-none"></div>
            </div>
            <span class="text-[8px] font-mono text-zinc-400 mt-1 uppercase tracking-wider bg-zinc-950/80 px-1 py-0.5 rounded border border-white/5">Rim Light</span>
          </div>
        </div>

        <!-- Floating UI panel simulating the addon -->
        <div class="absolute bottom-6 right-6 w-64 bg-zinc-950/80 border border-white/10 rounded-xl p-4 font-mono text-[9px] text-zinc-400 shadow-2xl backdrop-blur-md">
          <div class="flex items-center justify-between border-b border-white/5 pb-2 mb-3">
            <span class="text-white font-semibold">▼ SCENE LIGHT MANAGER</span>
            <span class="text-amber-400">[RIG_3POINT]</span>
          </div>
          <div class="space-y-3">
            <div>
              <div class="flex justify-between mb-1">
                <span>Base Energy</span>
                <span class="text-white">120 W</span>
              </div>
              <div class="w-full h-1.5 bg-zinc-900 rounded border border-white/5 overflow-hidden">
                <div class="w-3/5 h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between mb-1">
                <span>Contrast Ratio</span>
                <span class="text-white">4.2 : 1</span>
              </div>
              <div class="w-full h-1.5 bg-zinc-900 rounded border border-white/5 overflow-hidden">
                <div class="w-[75%] h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded"></div>
              </div>
            </div>
            <div class="flex gap-2 pt-1">
              <div class="flex-1 py-1 px-2 bg-zinc-900 hover:bg-zinc-800 rounded border border-white/5 text-center text-white cursor-pointer select-none">
                Link Light
              </div>
              <div class="flex-1 py-1 px-2 bg-zinc-900 hover:bg-zinc-800 rounded border border-white/5 text-center text-white cursor-pointer select-none">
                Spawn Rig
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Why Scene Light Manager? (The SLM Difference) -->
  <section class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 mb-28 border-t border-white/5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-amber-400 mb-2 block">
          🚀 The SLM Difference
        </span>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-6">
          Why Scene Light Manager?
        </h2>
        <p class="text-sm text-zinc-400 font-light leading-relaxed mb-6">
          In vanilla Blender, setting up cinematic lighting is a tedious loop: select a light, look at the properties panel, drag a slider, look back at the viewport, select another light, expand sub-panels, repeat.
        </p>
        <div class="p-4 rounded-xl bg-amber-500/5 border border-amber-500/10">
          <p class="text-xs text-amber-300 font-mono">
            <strong>SLM changes everything by bringing the controls to your cursor.</strong>
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Diff Card 1 -->
        <div class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300">
          <div class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2">
            <span class="text-xs">⚡</span> Zero Context Switching
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            Adjust power, size, beam angle, and color directly on the light object inside the 3D Viewport.
          </p>
        </div>

        <!-- Diff Card 2 -->
        <div class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300">
          <div class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2">
            <span class="text-xs">👁️</span> Instant Visual Feedback
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            High-fidelity GPU outlines highlight exactly which objects are affected by light or shadow linking in real time.
          </p>
        </div>

        <!-- Diff Card 3 -->
        <div class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300">
          <div class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2">
            <span class="text-xs">🌍</span> Intuitive Environment Controls
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            Rotate your HDRI or position the Nishita sun texture with simple viewport gestures.
          </p>
        </div>

        <!-- Diff Card 4 -->
        <div class="p-6 rounded-2xl bg-white/[0.01] border border-white/5 hover:border-amber-500/20 transition-all duration-300">
          <div class="text-amber-400 font-semibold text-sm mb-2 flex items-center gap-2">
            <span class="text-xs">⚙️</span> Pure Performance
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            Built from the ground up for heavy production scenes with zero overhead.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Key Features -->
  <section class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 mb-28 border-t border-white/5">
    <div class="text-center max-w-2xl mx-auto mb-20">
      <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-amber-400 mb-2 block">
        🌟 Feature Suite
      </span>
      <h2 class="text-3xl md:text-5xl font-light text-white tracking-tight leading-none mb-4">
        Key Features
      </h2>
      <p class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed">
        Engineered for technical lighting pipelines, providing professional UI tools and precise feedback controls.
      </p>
    </div>

    <!-- Feature alternating rows -->
    <div class="space-y-32">
      <!-- Feature 1 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs">
            01
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            Viewport Gizmo Interface & Floating Overlay
          </h3>
          <p class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed">
            Gain instant, contextual access to light settings directly on the active light:
          </p>
          <ul class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20">
            <li><strong class="text-zinc-200">Smart Buttons:</strong> Click interactive icons next to your selected light to cycle types, change area shapes, toggle solo mode, adjust spot beam spreads, or tweak sizes.</li>
            <li><strong class="text-zinc-200">Real-Time Value Overlay:</strong> Get beautiful, color-coded HUD feedback showing your precise parameter values as you drag. Choose to lock the HUD to your mouse or snap it cleanly below the gizmo cluster.</li>
            <li><strong class="text-zinc-200">Alt-Modifier Batch Control:</strong> Hold <code class="bg-zinc-900 px-1 py-0.5 rounded border border-white/5 text-amber-400">Alt</code> while adjusting a viewport gizmo to propagate the change to all selected lights instantly.</li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <div class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl">
            <img
              src={`${base}overlay_gizmos/viewport_2d_gizmos.png`}
              alt="Viewport Gizmos Adjustment Interface"
              class="w-full rounded-xl zoomable-img cursor-zoom-in hover:scale-[1.01] transition-transform duration-500"
            />
            <div class="absolute bottom-4 right-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none">
              Click to zoom
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl">
            <img
              src={`${base}overlay_gizmos/ll_and_sl_obkect_outline.png`}
              alt="Light and Shadow Linking Visual Highlights"
              class="w-full rounded-xl zoomable-img cursor-zoom-in hover:scale-[1.01] transition-transform duration-500"
            />
            <div class="absolute bottom-4 right-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none">
              Click to zoom
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs">
            02
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            High-Fidelity GPU Linking Highlights
          </h3>
          <p class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed">
            Configure Blender’s powerful Light and Shadow Linking systems visually:
          </p>
          <ul class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20">
            <li><strong class="text-zinc-200">Visual Silhouette Outlines:</strong> Selecting any light instantly projects clean, anti-aliased wireframes and silhouette highlights over the linked receiver or blocker geometry.</li>
            <li><strong class="text-zinc-200">Dynamic Customization:</strong> Choose from three outline modes (<em>Silhouette</em>, <em>Wireframe</em>, or <em>Both</em>), and customize line thickness and colors to match your scene style.</li>
          </ul>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-xs">
            03
          </div>
          <h3 class="text-2xl md:text-3xl font-light text-white leading-tight">
            Interactive HDRI & Sky Rotation
          </h3>
          <p class="text-xs md:text-sm text-zinc-400 font-light leading-relaxed">
            Ditch the shader editor mapping node. Rotate your environment from any camera angle:
          </p>
          <ul class="space-y-3 font-light text-xs text-zinc-400 pl-4 border-l border-amber-500/20">
            <li><strong class="text-zinc-200">Auto-Detection Engine:</strong> Automatically detects and rotates the active background environment—whether it is Nishita Sky, a World Mapping node (Z Rotation), or Blender's built-in Viewport HDRI.</li>
            <li><strong class="text-zinc-200">Instant Drag Gesture:</strong> Hold <code class="bg-zinc-900 px-1 py-0.5 rounded border border-white/5 text-amber-400">Ctrl + Alt + RMB</code> and drag horizontally to spin the dome. Release to commit, or cancel with a right click.</li>
            <li><strong class="text-zinc-200">HUD Angle Readout:</strong> A clean digital compass at the bottom of the viewport displays the exact rotation angle in real time.</li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <div class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-2 group shadow-2xl">
            <img
              src={`${base}overlay_gizmos/world_rotation.png`}
              alt="Interactive HDRI World Rotation"
              class="w-full rounded-xl zoomable-img cursor-zoom-in hover:scale-[1.01] transition-transform duration-500"
            />
            <div class="absolute bottom-4 right-4 bg-zinc-950/80 border border-white/10 rounded px-2.5 py-1 text-[9px] font-mono text-zinc-400 select-none">
              Click to zoom
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="relative rounded-2xl overflow-hidden border border-white/5 bg-zinc-900/40 p-8 shadow-2xl min-h-[300px] flex flex-col justify-center">
            <!-- Simulated Solo Overlay Graphic -->
            <div class="border border-white/10 bg-zinc-950/90 rounded-xl p-6 font-mono text-xs text-zinc-400 space-y-4">
