  <!-- Client-side Interactive Image Selectors Script -->
  <script>
    function setupImageToggles(
      btnAId: string,
      btnBId: string,
      imgAId: string,
      imgBId: string,
    ) {
      const btnA = document.getElementById(btnAId);
      const btnB = document.getElementById(btnBId);
      const imgA = document.getElementById(imgAId);
      const imgB = document.getElementById(imgBId);

      if (btnA && btnB && imgA && imgB) {
        const toggle = (showA: boolean) => {
          if (showA) {
            // Show A, hide B
            imgA.classList.remove("opacity-0", "pointer-events-none");
            imgA.classList.add("opacity-100");
            imgB.classList.add("opacity-0", "pointer-events-none");
            imgB.classList.remove("opacity-100");

            // Active A styles
            btnA.classList.add(
              "text-amber-400",
              "bg-amber-500/10",
              "border-amber-500/20",
            );
            btnA.classList.remove("text-zinc-400", "border-transparent");
            // Inactive B styles
            btnB.classList.remove(
              "text-amber-400",
              "bg-amber-500/10",
              "border-amber-500/20",
            );
            btnB.classList.add("text-zinc-400", "border-transparent");
          } else {
            // Show B, hide A
            imgA.classList.add("opacity-0", "pointer-events-none");
            imgA.classList.remove("opacity-100");
            imgB.classList.remove("opacity-0", "pointer-events-none");
            imgB.classList.add("opacity-100");

            // Active B styles
            btnB.classList.add(
              "text-amber-400",
              "bg-amber-500/10",
              "border-amber-500/20",
            );
            btnB.classList.remove("text-zinc-400", "border-transparent");
            // Inactive A styles
            btnA.classList.remove(
              "text-amber-400",
              "bg-amber-500/10",
              "border-amber-500/20",
            );
            btnA.classList.add("text-zinc-400", "border-transparent");
          }
        };

        btnA.addEventListener("click", () => toggle(true));
        btnB.addEventListener("click", () => toggle(false));
      }
    }

    // Initialize toggle behaviors
    setupImageToggles(
      "btn-world-a",
      "btn-world-b",
      "world-image-a",
      "world-image-b",
    );
    setupImageToggles(
      "btn-texture-a",
      "btn-texture-b",
      "texture-image-a",
      "texture-image-b",
    );
    setupImageToggles(
      "btn-presets-a",
      "btn-presets-b",
      "presets-image-a",
      "presets-image-b",
    );
  </script>
