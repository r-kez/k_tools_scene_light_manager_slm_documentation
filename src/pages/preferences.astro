---
import DocLayout from "../layouts/DocLayout.astro";
import PreferencesTabs from "../components/PreferencesTabs.astro";

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences Ã¢â¬â Selection Sync">
  <h1>Addon Preferences Configuration</h1>
  <PreferencesTabs
    activeTab="preferences"
    description="Configure how selections in the SLM light list stay in sync with Blender viewport, outliner, and collection hierarchies."
  />

  <!-- General Preferences Image -->
  <div
    class="bg-zinc-950/40 border border-white/5 p-4 rounded-2xl mb-8 group hover:border-white/10 transition-all duration-300"
  >
    <div
      class="overflow-hidden rounded-xl bg-black/40 border border-white/5 mb-3 flex justify-center"
    >
      <img
        src={`${base}panel_images/preferences-general_and_sync.png`}
        alt="General Preferences & Sync Configuration"
        class="h-auto max-h-[350px] object-contain transition-transform duration-500 group-hover:scale-[1.01] zoomable-img cursor-zoom-in"
        loading="lazy"
      />
    </div>
    <span class="text-zinc-500 text-[11px] block font-mono text-center"
      >Addon Preferences Ã¢â¬â General Settings & Scene Sync Options</span
    >
  </div>

  <div class="space-y-12">
    <!-- SECTION 1: SELECTION & OUTLINER SYNC -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div
          class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">
            Selection & Outliner Sync
          </h2>
          <p class="text-zinc-500 text-xs mt-0.5">
            Control how viewport selections synchronize with list hierarchies
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Card: Sync Selection -->
        <div
          id="sync_selection"
          class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300"
        >
          <div>
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2"
            >
              <strong class="text-white text-sm">Sync Selection</strong>
              <span
                class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >sync_selection</span
              >
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Maintains exact synchronization between selections in the SLM list
              and Blender's viewport/outliner. Selecting a light in the list
              selects it in the 3D scene, and vice-versa.
            </p>
          </div>
          <div
            class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono"
          >
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-green-500/80">True</span></span>
          </div>
        </div>

        <!-- Card: Fallback to World on Deselect -->
        <div
          id="sync_world_fallback"
          class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300"
        >
          <div>
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2"
            >
              <strong class="text-white text-sm"
                >Fallback to World on Deselect</strong
              >
              <span
                class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >sync_world_fallback</span
              >
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Automatically selects the World/HDRI settings inside the light
              list whenever you clear your active viewport selection. Provides
              instant access to global environment rotation.
            </p>
          </div>
          <div
            class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono"
          >
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-red-500/80">False</span></span>
          </div>
        </div>

        <!-- Card: Sync Collection Selection -->
        <div
          id="sync_collection_selection"
          class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300"
        >
          <div>
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2"
            >
              <strong class="text-white text-sm"
                >Sync Collection Selection</strong
              >
              <span
                class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >sync_collection_selection</span
              >
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Links collection folder highlights. Clicking a light rig
              collection header inside the list automatically selects the
              corresponding collection within the native Blender Outliner.
            </p>
          </div>
          <div
            class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono"
          >
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-red-500/80">False</span></span>
          </div>
        </div>

        <!-- Card: Show Debug Messages -->
        <div
          class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300"
        >
          <div>
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2"
            >
              <strong class="text-white text-sm">Show Debug Messages</strong>
              <span
                class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >show_debug_messages</span
              >
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Enables granular debug prints inside Blender's system console.
              Highly recommended to keep disabled during daily lighting sessions
              to avoid performance clutter.
            </p>
          </div>
          <div
            class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono"
          >
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-red-500/80">False</span></span>
          </div>
        </div>
      </div>
    </section>
  </div>
</DocLayout>
