---
import DocLayout from '../../layouts/DocLayout.astro';
import PreferencesTabs from '../../components/PreferencesTabs.astro';

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences — Environment & HDRI">
  <h1>Addon Preferences Configuration</h1>
  <PreferencesTabs activeTab="preferences/hdri-environment" description="Configure your HDRI folder path and generate cached thumbnails for fast environment map selection inside the viewport browser." />

  <!-- Library Preferences Image -->
  <div class="bg-zinc-950/40 border border-white/5 p-4 rounded-2xl mb-8 group hover:border-white/10 transition-all duration-300">
    <div class="overflow-hidden rounded-xl bg-black/40 border border-white/5 mb-3 flex justify-center">
      <img
        src={`${base}panel_images/preferences-library.png`}
        alt="Library Paths & Assets Preferences"
        class="h-auto max-h-[300px] object-contain transition-transform duration-500 group-hover:scale-[1.01] zoomable-img cursor-zoom-in"
        loading="lazy"
      />
    </div>
    <span class="text-zinc-500 text-[11px] block font-mono text-center">Addon Preferences — HDRI Directory & Preview Generation</span>
  </div>

  <div class="space-y-12">

    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Environment & HDRI Mapping</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Scan, index, and cache world map thumbnails in your asset pipeline</p>
        </div>
      </div>

      <div id="k_tools_hdri_folder" class="bg-white/[0.01] border border-white/5 p-6 rounded-2xl hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300 space-y-4">
        <div class="flex flex-col md:flex-row justify-between gap-4 items-start md:items-center">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
              <strong class="text-white text-sm">HDRI Folder Path</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">k_tools_hdri_folder</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Select the directory storing environment maps (<code>.hdr</code>, <code>.exr</code>, <code>.jpg</code>, <code>.png</code>). SLM parses this target path dynamically, linking environments to the World rotation presets.
            </p>
          </div>
          <div class="text-[10px] text-zinc-500 font-mono flex-shrink-0">
            <span>Type: <span class="text-amber-500/80">String (Directory Path)</span></span>
          </div>
        </div>

        <div class="h-[1px] bg-white/5"></div>

        <div class="flex flex-col md:flex-row justify-between gap-4 items-start md:items-center">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
              <strong class="text-white text-sm">Generate Previews</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800/80 text-[10px] font-mono text-zinc-500 self-start sm:self-auto break-all">k_tools.generate_hdri_previews</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              A manual operator that executes background scans. It computes and caches lightweight viewport thumbnails for every HDRI file indexed inside your selected path.
            </p>
          </div>
          <div class="flex-shrink-0">
            <span class="px-3 py-1.5 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-300 text-[10px] font-semibold flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.2" />
              </svg>
              Operator
            </span>
          </div>
        </div>
      </div>
    </section>

  </div>
</DocLayout>

