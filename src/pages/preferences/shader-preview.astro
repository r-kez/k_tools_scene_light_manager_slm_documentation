---
import DocLayout from '../../layouts/DocLayout.astro';
import PreferencesTabs from '../../components/PreferencesTabs.astro';

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences — Shader Preview">
  <h1>Addon Preferences Configuration</h1>
  <PreferencesTabs activeTab="preferences/shader-preview" description="Control how and when the Shader Preview thumbnail regenerates, and select the compute device used during preview renders." />

  <!-- ââ Shader Preview Engine ââ -->
  <div class="space-y-12">
    
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Shader Preview Engine</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Control compute devices and refresh loops for emissive material previews</p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Card: Auto Refresh Interval -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Refresh Interval</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">preview_refresh_interval</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Timer delay (in seconds) used to debounce and trigger the persistent scene preview render updates after modifying shader nodes or parameters.
            </p>
          </div>
          <div class="flex flex-col gap-1 mt-4 text-[10px] text-zinc-500 font-mono">
            <div>Type: <span class="text-amber-500/80">Float</span></div>
            <div>Default: <span class="text-zinc-300">1.5s</span> <span class="text-zinc-600">(0.2s - 10.0s)</span></div>
          </div>
        </div>

        <!-- Card: Preview Render Engine -->
        <div id="preview_render_engine" class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Render Engine</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">preview_render_engine</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              The internal engine used to render shader thumbnail material maps. Cycles is strongly recommended as it runs asynchronously in the background.
            </p>
          </div>
          <div class="flex flex-col gap-1 mt-4 text-[10px] text-zinc-500 font-mono">
            <div>Type: <span class="text-amber-500/80">Enum</span></div>
            <div>Default: <span class="text-zinc-300">CYCLES</span> <span class="text-zinc-600">(EEVEE / CYCLES)</span></div>
          </div>
        </div>

        <!-- Card: Cycles Preview Device -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Cycles Device</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">preview_render_device</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Allocates CPU or GPU compute hardware to render the Cycles thumbnail previews. Only visible/active when Preview Render Engine is set to Cycles.
            </p>
          </div>
          <div class="flex flex-col gap-1 mt-4 text-[10px] text-zinc-500 font-mono">
            <div>Type: <span class="text-amber-500/80">Enum</span></div>
            <div>Default: <span class="text-zinc-300">GPU</span> <span class="text-zinc-600">(CPU / GPU)</span></div>
          </div>
        </div>
      </div>

      <div class="bg-amber-500/5 border border-amber-500/10 rounded-2xl p-5 mt-4">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div class="space-y-1">
            <h4 class="text-xs font-semibold text-white">Performance Warning: EEVEE vs Cycles Previews</h4>
            <p class="text-zinc-400 text-xs leading-relaxed font-light">
              If adjusting emitter exposure or color inputs causes viewport stuttering, ensure <strong>Cycles (GPU)</strong> is selected. Cycles renders thumbnails asynchronously in background threads, whereas EEVEE compiles shaders synchronously on Blender's main thread, causing temporary viewport frame drops.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</DocLayout>

