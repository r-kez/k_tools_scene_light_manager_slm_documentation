---
import DocLayout from "../../layouts/DocLayout.astro";
import PreferencesTabs from "../../components/PreferencesTabs.astro";

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences Ã¢â¬â Library & Node Groups">
  <h1>Addon Preferences Configuration</h1>
  <PreferencesTabs
    activeTab="preferences/library-hdri"
    description="Toggle automated softbox shader assignment and register the SLM bundled asset library inside Blender file paths."
  />

  <!-- Library Preferences Image -->
  <div
    class="bg-zinc-950/40 border border-white/5 p-4 rounded-2xl mb-8 group hover:border-white/10 transition-all duration-300"
  >
    <div
      class="overflow-hidden rounded-xl bg-black/40 border border-white/5 mb-3 flex justify-center"
    >
      <img
        src={`${base}panel_images/preferences-library.png`}
        alt="Library Paths & Assets Preferences"
        class="h-auto max-h-[300px] object-contain transition-transform duration-500 group-hover:scale-[1.01] zoomable-img cursor-zoom-in"
        loading="lazy"
      />
    </div>
    <span class="text-zinc-500 text-[11px] block font-mono text-center"
      >Addon Preferences Ã¢â¬â Assets Library & HDRI Paths</span
    >
  </div>

  <div class="space-y-12">
    <!-- SECTION 1: ASSET LIBRARY & NODE GROUPS -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div
          class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">
            Library & Node Groups
          </h2>
          <p class="text-zinc-500 text-xs mt-0.5">
            Toggle automated shader templates and register bundled asset
            directories
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Auto-Assign Softbox -->
        <div
          id="auto_assign_softbox"
          class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300"
        >
          <div>
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2"
            >
              <strong class="text-white text-sm">Auto-Assign Softbox</strong>
              <span
                class="px-2 py-0.5 rounded bg-zinc-900 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >auto_assign_softbox</span
              >
            </div>
            <p
              class="text-xs text-zinc-400 leading-relaxed font-light font-sans"
            >
              Automatically assigns the custom Area Light Shader Node Group to
              any newly created Area Light (both native Blender and addon
              sources), bypassing manual node tree editing.
            </p>
          </div>
          <div
            class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono"
          >
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-green-500/80">True</span></span>
          </div>
        </div>

        <!-- Register Asset Library -->
        <div
          class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300"
        >
          <div>
            <div
              class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2"
            >
              <strong class="text-white text-sm">Register Addon Assets</strong>
              <span
                class="px-2 py-0.5 rounded bg-zinc-900 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >k_tools.register_asset_library</span
              >
            </div>
            <p
              class="text-xs text-zinc-400 leading-relaxed font-light font-sans"
            >
              Registers the Scene Light Manager bundled asset library (which
              contains custom softbox HDR textures, pre-built lighting rigs, and
              reflector setups) inside Blender's File Paths preferences.
            </p>
          </div>
          <div
            class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono"
          >
            <span>Type: <span class="text-amber-500/80">Operator</span></span>
            <span>â¢</span>
            <span
              >Action: <span class="text-zinc-300">Register Library</span></span
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</DocLayout>
