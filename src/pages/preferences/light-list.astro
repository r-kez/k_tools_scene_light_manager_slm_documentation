---
import DocLayout from '../../layouts/DocLayout.astro';
import PreferencesTabs from '../../components/PreferencesTabs.astro';

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences — Light List & Detection">
  <h1>Addon Preferences Configuration</h1>
  <p class="text-zinc-400 text-sm leading-relaxed mb-6 font-light">
    Configure which columns and quick-action icons appear on the main interface, set up viewport helper display rules, and customize auto-detection keywords for custom meshes.
  </p>

  <PreferencesTabs activeTab="preferences/light-list" />

  <!-- List Preferences Image -->
  <div class="bg-zinc-950/40 border border-white/5 p-4 rounded-2xl mb-8 group hover:border-white/10 transition-all duration-300">
    <div class="overflow-hidden rounded-xl bg-black/40 border border-white/5 mb-3 flex justify-center">
      <img 
        src={`${base}panel_images/preferences-list_and_detection.png`} 
        alt="Light List Preferences" 
        class="h-auto max-h-[350px] object-contain transition-transform duration-500 group-hover:scale-[1.01] zoomable-img cursor-zoom-in"
        loading="lazy"
      />
    </div>
    <span class="text-zinc-500 text-[11px] block font-mono text-center">Addon Preferences — Main Light List UI layout configurations</span>
  </div>

  <!-- ── 2. Light List & Component Detection Settings ── -->
  <div class="space-y-12">
    
    <!-- SECTION 1: INTERFACE COLUMNS TOGGLES -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Interface Columns & Toggles</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Streamline the list footprint by toggling visible data columns</p>
        </div>
      </div>

      <div class="bg-white/[0.01] border border-white/5 rounded-2xl p-6">
        <p class="text-xs text-zinc-400 mb-4 font-light leading-relaxed">
          Enable or disable specific column headers and toggle switches to suit your screen real estate and workflow complexity:
        </p>

        <div class="grid grid-cols-1 gap-4 text-xs">
          <!-- View Layer Exclude -->
          <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">View Layer Exclude</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_view_layer</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Show/Hide the collection checkboxes that include/exclude layers. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Selectability Toggles -->
          <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Selectability Lock</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_select</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Displays arrow icons to toggle whether a light object is clickable in the 3D viewport. <strong class="text-red-500/70 font-mono text-[9px]">(Default: False)</strong></p>
          </div>

          <!-- Viewport Eye Icons -->
          <div id="show_hide_viewport" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Viewport Visibility</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_viewport</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Shows eye icons to show/hide light geometries inside the 3D viewport. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Render Camera Icons -->
          <div id="show_hide_render" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Render Toggle</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_render</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Displays camera icons to toggle whether a light contributes to final F12 outputs. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Exposure Locks -->
          <div id="show_hide_exposure" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Exposure Lock Column</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_exposure</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Shows lock icons to freeze exposure values, protecting them from batch adjustments. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Light Group Tags -->
          <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Light Group Assignments</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_lightgroup</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Displays interactive tag widgets for assigning lights to compositor light groups. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Linking Columns -->
          <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Light Linking</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_light_linking</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Toggles display of the <code>LL</code> (Light Link) column. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Shadow Linking -->
          <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Shadow Linking</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_shadow_linking</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Toggles display of the <code>SL</code> (Shadow Link) column. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>

          <!-- Targets and Controllers -->
          <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
              <span class="text-white font-medium">Targets & Controllers</span>
              <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">show_hide_targets</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Displays icons indicating whether a light contains tracking constraints or target empties. <strong class="text-green-500/70 font-mono text-[9px]">(Default: True)</strong></p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: ADVANCED LIST BEHAVIOR -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Advanced List Behavior</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Configure automated behaviors when selecting or displaying list items</p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Card: Auto-Expand Selected Light -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Auto-Expand Selected Light</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">auto_expand_active_light</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Automatically unfolds the selected light's nested properties row (revealing direct power sliders, color swatches, and node inputs) the moment you click or select it.
            </p>
          </div>
          <div class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>•</span>
            <span>Default: <span class="text-red-500/80">False</span></span>
          </div>
        </div>

        <!-- Card: Show World in Outliner/List -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Show World in Outliner</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">show_world_in_list</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Appends a permanent "World Shader" entry at the top of the UI list, giving you instant access to rotate HDRIs, change sky colors, or toggle environmental ray visibility without navigating elsewhere.
            </p>
          </div>
          <div class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>•</span>
            <span>Default: <span class="text-green-500/80">True</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: VIEWPORT DISPLAY & SOLO ISOLATION -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Viewport Display & Solo Isolation</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Control helper geometries and isolated preview behaviors in the 3D viewport</p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Card: Display Helpers as Wireframe -->
        <div id="spawn_helpers_as_wire" class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Helpers as Wire</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">spawn_helpers_as_wire</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Automatically sets spawned bouncers, blockers, and catchers to render as wireframes. Prevents solid shading from occluding your viewport objects and lights.
            </p>
          </div>
          <div class="flex flex-col gap-1 mt-4 text-[10px] text-zinc-500 font-mono">
            <div>Type: <span class="text-amber-500/80">Boolean</span></div>
            <div>Default: <span class="text-green-500/80">True</span></div>
          </div>
        </div>

        <!-- Card: Isolate Active Collection Only -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Isolate Collection Only</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">isolate_current_group_only</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              When toggling a light's Solo mode, restrict muting actions exclusively to other lights within the active collection rig. External light rigs remain untouched.
            </p>
          </div>
          <div class="flex flex-col gap-1 mt-4 text-[10px] text-zinc-500 font-mono">
            <div>Type: <span class="text-amber-500/80">Boolean</span></div>
            <div>Default: <span class="text-red-500/80">False</span></div>
          </div>
        </div>

        <!-- Card: Disable World Nodes (Mute HDRI) -->
        <div id="isolate_disable_world_nodes" class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Disable World Nodes</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">isolate_disable_world_nodes</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Mutes the World environment backgrounds and HDRIs when a light's Solo mode is enabled. Ideal for analyzing the precise impact of a single lamp in total pitch-black darkness.
            </p>
          </div>
          <div class="flex flex-col gap-1 mt-4 text-[10px] text-zinc-500 font-mono">
            <div>Type: <span class="text-amber-500/80">Boolean</span></div>
            <div>Default: <span class="text-green-500/80">True</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: COMPONENT DETECTION & KEYWORD SCANNERS -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Component Detection & Keyword Scanners</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Customize suffixes and keyword lists for automatic scene mapping</p>
        </div>
      </div>

      <div class="bg-white/[0.01] border border-white/5 p-6 rounded-2xl hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300 space-y-6">
        <!-- List Mesh Lights -->
        <div id="enable_mesh_lights" class="flex flex-col md:flex-row justify-between gap-4 items-start md:items-center">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
              <strong class="text-white text-sm">Scan Emissive Mesh Lights</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">enable_mesh_lights</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Allows the background loop to parse emissive material slots (mesh lights) and list them. For extremely dense architectural/CAD scenes, disable this setting to eliminate potential depsgraph update lag.
            </p>
          </div>
          <div class="flex-shrink-0 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>•</span>
            <span>Default: <span class="text-green-500/80">True</span></span>
          </div>
        </div>

        <div class="h-[1px] bg-white/5"></div>

        <!-- Keyword Suffix Lists -->
        <div>
          <h4 class="text-xs font-semibold text-white mb-3">Automatic Suffix Keyword Filters</h4>
          <p class="text-xs text-zinc-400 font-light leading-relaxed mb-4">
            Scene Light Manager automatically indexes non-light mesh objects if their names contain any of the comma-separated keywords defined below:
          </p>

          <div class="grid grid-cols-1 gap-4 text-xs">
            <!-- Mesh Lights Suffixes -->
            <div id="mesh_light_search_terms" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between">
              <div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                  <span class="text-white font-medium">Mesh Light Suffixes</span>
                  <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">mesh_light_search_terms</span>
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Keywords matching custom mesh lamps with emissive node trees.</p>
              </div>
              <div class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded">
                Default: "mesh_light,meshlight,emissive"
              </div>
            </div>

            <!-- Bouncers Suffixes -->
            <div id="bouncer_search_terms" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between">
              <div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                  <span class="text-white font-medium">Reflector / Bouncer Suffixes</span>
                  <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">bouncer_search_terms</span>
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Keywords matching reflector planes and bounces in the viewport list.</p>
              </div>
              <div class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded">
                Default: "bouncer,reflector"
              </div>
            </div>

            <!-- Blockers Suffixes -->
            <div id="blocker_search_terms" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between">
              <div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                  <span class="text-white font-medium">Gobo / Blocker Suffixes</span>
                  <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">blocker_search_terms</span>
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Keywords matching shadow cards, flags, and gobos.</p>
              </div>
              <div class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded">
                Default: "blocker,gobo"
              </div>
            </div>

            <!-- Catchers Suffixes -->
            <div id="catcher_search_terms" class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between">
              <div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                  <span class="text-white font-medium">Matte / Catcher Suffixes</span>
                  <span class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all">catcher_search_terms</span>
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">Keywords matching custom ground planes tagged as shadow catchers.</p>
              </div>
              <div class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded">
                Default: "catcher,shadow_catcher,shadowcatcher,matte"
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</DocLayout>

