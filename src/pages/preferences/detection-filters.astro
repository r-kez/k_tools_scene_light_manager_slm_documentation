---
import DocLayout from "../../layouts/DocLayout.astro";
import PreferencesTabs from "../../components/PreferencesTabs.astro";

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences — Detection & Keyword Filters">
  <h1>Addon Preferences Configuration</h1>
  <PreferencesTabs
    activeTab="preferences/detection-filters"
    description="Define the suffix keyword lists used to automatically categorize mesh objects as emissive lights, reflectors, blockers, or shadow catchers."
  />

  <div class="space-y-12">
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div
          class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">
            Component Detection & Keyword Scanners
          </h2>
          <p class="text-zinc-500 text-xs mt-0.5">
            Customize suffixes and keyword lists for automatic scene mapping
          </p>
        </div>
      </div>

      <div
        class="bg-white/[0.01] border border-white/5 p-6 rounded-2xl hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300 space-y-6"
      >
        <!-- List Mesh Lights -->
        <div
          id="enable_mesh_lights"
          class="flex flex-col md:flex-row justify-between gap-4 items-start md:items-center"
        >
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
              <strong class="text-white text-sm"
                >Scan Emissive Mesh Lights</strong
              >
              <span
                class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all"
                >enable_mesh_lights</span
              >
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Allows the background loop to parse emissive material slots (mesh
              lights) and list them. For extremely dense architectural/CAD
              scenes, disable this setting to eliminate potential depsgraph
              update lag.
            </p>
          </div>
          <div
            class="flex-shrink-0 text-[10px] text-zinc-500 font-mono flex items-center gap-2"
          >
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>•</span>
            <span>Default: <span class="text-green-500/80">True</span></span>
          </div>
        </div>

        <div class="h-[1px] bg-white/5"></div>

        <!-- Keyword Suffix Lists -->
        <div>
          <h4 class="text-xs font-semibold text-white mb-3">
            Automatic Suffix Keyword Filters
          </h4>
          <p class="text-xs text-zinc-400 font-light leading-relaxed mb-4">
            Scene Light Manager automatically indexes non-light mesh objects if
            their names contain any of the comma-separated keywords defined
            below:
          </p>

          <div class="grid grid-cols-1 gap-4 text-xs">
            <!-- Mesh Lights Suffixes -->
            <div
              id="mesh_light_search_terms"
              class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between"
            >
              <div>
                <div
                  class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5"
                >
                  <span class="text-white font-medium">Mesh Light Suffixes</span
                  >
                  <span
                    class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all"
                    >mesh_light_search_terms</span
                  >
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
                  Keywords matching custom mesh lamps with emissive node trees.
                </p>
              </div>
              <div
                class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded"
              >
                Default: "mesh_light,meshlight,emissive"
              </div>
            </div>

            <!-- Bouncers Suffixes -->
            <div
              id="bouncer_search_terms"
              class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between"
            >
              <div>
                <div
                  class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5"
                >
                  <span class="text-white font-medium"
                    >Reflector / Bouncer Suffixes</span
                  >
                  <span
                    class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all"
                    >bouncer_search_terms</span
                  >
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
                  Keywords matching reflector planes and bounces in the viewport
                  list.
                </p>
              </div>
              <div
                class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded"
              >
                Default: "bouncer,reflector"
              </div>
            </div>

            <!-- Blockers Suffixes -->
            <div
              id="blocker_search_terms"
              class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between"
            >
              <div>
                <div
                  class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5"
                >
                  <span class="text-white font-medium"
                    >Gobo / Blocker Suffixes</span
                  >
                  <span
                    class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all"
                    >blocker_search_terms</span
                  >
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
                  Keywords matching shadow cards, flags, and gobos.
                </p>
              </div>
              <div
                class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded"
              >
                Default: "blocker,gobo"
              </div>
            </div>

            <!-- Catchers Suffixes -->
            <div
              id="catcher_search_terms"
              class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col justify-between"
            >
              <div>
                <div
                  class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5"
                >
                  <span class="text-white font-medium"
                    >Matte / Catcher Suffixes</span
                  >
                  <span
                    class="text-[9px] font-mono text-zinc-500 bg-zinc-900 px-1.5 py-0.5 rounded self-start sm:self-auto break-all"
                    >catcher_search_terms</span
                  >
                </div>
                <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
                  Keywords matching custom ground planes tagged as shadow
                  catchers.
                </p>
              </div>
              <div
                class="mt-4 font-mono text-[10px] text-amber-500/80 bg-white/[0.02] border border-white/5 p-2 rounded"
              >
                Default: "catcher,shadow_catcher,shadowcatcher,matte"
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</DocLayout>
