---
import DocLayout from '../../layouts/DocLayout.astro';
import PreferencesTabs from '../../components/PreferencesTabs.astro';
---

<DocLayout title="Preferences — Library & Keybindings">
  <h1>Addon Preferences Configuration</h1>
  <p class="text-zinc-400 text-sm leading-relaxed mb-6 font-light">
    Configure custom asset paths, default shader node group assignments, and mapping shortcuts for modal operations or interactive tools.
  </p>

  <PreferencesTabs activeTab="preferences/keybindings" />

  <!-- ── 4. Library & Keybindings Settings ── -->
  <div class="space-y-12">
    
    <!-- SECTION 1: ASSET LIBRARY & NODE GROUPS -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Library & Node Groups</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Toggle automated shader templates and register bundled asset directories</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Auto-Assign Softbox -->
        <div id="auto_assign_softbox" class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Auto-Assign Softbox</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-900 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">auto_assign_softbox</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light font-sans">
              Automatically assigns the custom Area Light Shader Node Group to any newly created Area Light (both native Blender and addon sources), bypassing manual node tree editing.
            </p>
          </div>
          <div class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>•</span>
            <span>Default: <span class="text-green-500/80">True</span></span>
          </div>
        </div>

        <!-- Register Asset Library -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Register Addon Assets</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-900 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">k_tools.register_asset_library</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light font-sans">
              Registers the Scene Light Manager bundled asset library (which contains custom softbox HDR textures, pre-built lighting rigs, and reflector setups) inside Blender's File Paths preferences.
            </p>
          </div>
          <div class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Operator</span></span>
            <span>•</span>
            <span>Action: <span class="text-zinc-300">Register Library</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: KEYBOARD SHORTCUTS -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Keyboard Shortcuts (Keybindings)</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Customize hotkeys for modal operators and interactive viewport tools</p>
        </div>
      </div>

      <div class="bg-white/[0.01] border border-white/5 rounded-2xl p-6">
        <p class="text-xs text-zinc-400 mb-6 font-light leading-relaxed">
          Tweak global shortcut mappings inside Blender's keymap editor. Below are the key operators registered by the addon and their default key configurations:
        </p>

        <!-- Shortcuts Card Stack -->
        <div class="space-y-4">
          <!-- Quick Popup -->
          <div class="p-4 bg-zinc-950/40 border border-white/5 rounded-xl hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
              <div>
                <span class="text-white font-medium block">Quick Popup Panel</span>
                <code class="text-[9px] text-zinc-500 block break-all whitespace-normal mt-1">k_tools.quick_popup</code>
              </div>
              <div class="self-start sm:self-auto">
                <kbd class="px-2 py-1 rounded bg-zinc-900 border border-white/10 text-amber-400 font-mono text-xs font-semibold shadow-inner">Y</kbd>
              </div>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
              Launches the floating popup panel at the mouse cursor location inside the 3D viewport containing selection, light parameters, and active preset controls.
            </p>
          </div>

          <!-- Rotate HDRI -->
          <div class="p-4 bg-zinc-950/40 border border-white/5 rounded-xl hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
              <div>
                <span class="text-white font-medium block">Interactive HDRI Rotation</span>
                <code class="text-[9px] text-zinc-500 block break-all whitespace-normal mt-1">k_tools.rotate_hdri</code>
              </div>
              <div class="self-start sm:self-auto">
                <kbd class="px-2 py-1 rounded bg-zinc-900 border border-white/10 text-amber-400 font-mono text-[10px] font-semibold shadow-inner">Ctrl + Alt + RMB (Drag)</kbd>
              </div>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
              Triggers the modal mouse-drag tool to rotate the world environment mapping coordinates, Nishita Sun angles, or viewport HDRI values in real-time.
            </p>
          </div>

          <!-- Light At Point -->
          <div class="p-4 bg-zinc-950/40 border border-white/5 rounded-xl hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
              <div>
                <span class="text-white font-medium block">Interactive Light Placement (Pointer)</span>
                <code class="text-[9px] text-zinc-500 block break-all whitespace-normal mt-1">k_tools.light_at_point</code>
              </div>
              <div class="self-start sm:self-auto">
                <span class="text-[10px] font-mono text-zinc-600 bg-zinc-900 px-2 py-1 rounded border border-white/5">Not Set</span>
              </div>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
              Projects active light emitter coordinates directly onto a target mesh surface using viewport raycasting and normal alignment.
            </p>
          </div>

          <!-- Navigate Light -->
          <div class="p-4 bg-zinc-950/40 border border-white/5 rounded-xl hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
              <div>
                <span class="text-white font-medium block">Navigate Active Light (Next / Prev)</span>
                <code class="text-[9px] text-zinc-500 block break-all whitespace-normal mt-1">k_tools.navigate_light (target="LIGHT")</code>
              </div>
              <div class="self-start sm:self-auto flex gap-1.5">
                <kbd class="px-2 py-1 rounded bg-zinc-900 border border-white/10 text-amber-400 font-mono text-xs font-semibold shadow-inner">.</kbd>
                <span class="text-zinc-600">/</span>
                <kbd class="px-2 py-1 rounded bg-zinc-900 border border-white/10 text-amber-400 font-mono text-xs font-semibold shadow-inner">,</kbd>
              </div>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
              Quickly step up or down through the list of lights inside your active viewport or selection group.
            </p>
          </div>

          <!-- Navigate Collection -->
          <div class="p-4 bg-zinc-950/40 border border-white/5 rounded-xl hover:border-amber-500/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
              <div>
                <span class="text-white font-medium block">Navigate Active Collection (Next / Prev)</span>
                <code class="text-[9px] text-zinc-500 block break-all whitespace-normal mt-1">k_tools.navigate_light (target="COLLECTION")</code>
              </div>
              <div class="self-start sm:self-auto flex gap-1.5">
                <kbd class="px-2 py-1 rounded bg-zinc-900 border border-white/10 text-amber-400 font-mono text-[10px] font-semibold shadow-inner">Shift + .</kbd>
                <span class="text-zinc-600">/</span>
                <kbd class="px-2 py-1 rounded bg-zinc-900 border border-white/10 text-amber-400 font-mono text-[10px] font-semibold shadow-inner">Shift + ,</kbd>
              </div>
            </div>
            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
              Step up or down through the light collections registered inside the Scene Light Manager UI list structure.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</DocLayout>
