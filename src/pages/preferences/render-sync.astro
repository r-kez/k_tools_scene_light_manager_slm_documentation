---
import DocLayout from '../../layouts/DocLayout.astro';
import PreferencesTabs from '../../components/PreferencesTabs.astro';

const base = import.meta.env.BASE_URL;
---

<DocLayout title="Preferences — Render & Visibility Sync">
  <h1>Addon Preferences Configuration</h1>
  <PreferencesTabs activeTab="preferences/render-sync" description="Maintain perfect synchronization between Blender viewport visibility states and final render outputs via Python-driven data links." />

  <div class="space-y-12">

    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <div>
          <h2 class="text-white text-base font-semibold m-0">Render & Visibility Sync</h2>
          <p class="text-zinc-500 text-xs mt-0.5">Maintain perfect sync between Blender's viewport and final render visibility states</p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Card: Sync Render Visibility -->
        <div id="sync_visibility_drivers" class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Sync Render Visibility</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">sync_visibility_drivers</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Automatically creates Python-driven data links between <code>hide_viewport</code> and <code>hide_render</code>. Prevents the common Blender issue where objects hidden in the viewport still appear in final renders.
            </p>
          </div>
          <div class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-red-500/80">False</span></span>
          </div>
        </div>

        <!-- Card: Show Selected Light in Camera Render -->
        <div class="bg-white/[0.01] border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-amber-500/20 hover:bg-white/[0.02] transition-all duration-300">
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <strong class="text-white text-sm">Show Selected Light in Camera Render</strong>
              <span class="px-2 py-0.5 rounded bg-zinc-800 text-[10px] font-mono text-zinc-400 self-start sm:self-auto break-all">temp_visible_camera_on_select</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed font-light">
              Forces <code>visible_camera</code> to be active temporarily for the selected light shape/emitter. Makes the physical softbox card geometry visible to camera rays exclusively during viewport selection adjustments.
            </p>
          </div>
          <div class="flex items-center gap-2 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Type: <span class="text-amber-500/80">Boolean</span></span>
            <span>â¢</span>
            <span>Default: <span class="text-red-500/80">False</span></span>
          </div>
        </div>
      </div>

      <div class="bg-amber-500/5 border border-amber-500/10 rounded-2xl p-5 mt-4">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="space-y-1">
            <h4 class="text-xs font-semibold text-white">How Visibility Drivers Work</h4>
            <p class="text-zinc-400 text-xs leading-relaxed font-light">
              When <strong>Sync Render Visibility</strong> is enabled, SLM injects Blender drivers linking the object properties directly. If you toggle the Eye icon in the light list, Blender's dependency graph immediately updates the Camera render state as well, ensuring absolute safety for final outputs.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</DocLayout>

