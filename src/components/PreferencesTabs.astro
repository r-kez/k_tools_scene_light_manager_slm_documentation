---
const base = import.meta.env.BASE_URL;
const { activeTab, description } = Astro.props;

const tabs = [
  { label: 'Selection Sync', path: 'preferences' },
  { label: 'Render Sync', path: 'preferences/render-sync' },
  { label: 'Shader Preview', path: 'preferences/shader-preview' },
  { label: 'Library & Node Groups', path: 'preferences/library-hdri' },
  { label: 'Environment & HDRI', path: 'preferences/hdri-environment' },
  { label: 'Sidebar Tab Config', path: 'preferences/sidebar-config' },
  { label: 'List Columns', path: 'preferences/list-toggles' },
  { label: 'List Behavior', path: 'preferences/list-behavior' },
  { label: 'Viewport Isolation', path: 'preferences/viewport-isolation' },
  { label: 'Detection & Filters', path: 'preferences/detection-filters' },
  { label: 'Viewport Gizmos', path: 'preferences/viewport-gizmos' },
  { label: 'Keyboard Shortcuts', path: 'preferences/keybindings' },
];

const relLink = (path: string) => {
  const safeBase = base.endsWith('/') ? base : `${base}/`;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  return `${safeBase}${cleanPath}`;
};
---

<div class="mb-8">
  <div class="flex flex-wrap justify-center gap-2 border-b border-white/5 pb-6 font-mono text-[9px] md:text-[10px] uppercase tracking-wider">
    {tabs.map(tab => {
      const isCurrent = activeTab === tab.path;
      return (
        <a
          href={relLink(tab.path)}
          class={`px-3 md:px-4 py-2 rounded-lg border transition-all duration-300 ${
            isCurrent
              ? 'bg-amber-500/10 border-amber-500/30 text-amber-400 font-semibold shadow-[0_0_15px_rgba(245,158,11,0.05)]'
              : 'bg-white/[0.01] border-white/5 text-zinc-500 hover:text-zinc-200 hover:bg-white/[0.03]'
          }`}
        >
          {tab.label}
        </a>
      );
    })}
  </div>

  {description && (
    <p class="text-zinc-400 text-sm leading-relaxed mt-5 font-light">
      {description}
    </p>
  )}
</div>

